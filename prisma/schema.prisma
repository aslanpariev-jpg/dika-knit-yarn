generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  pinHash         String
  role            Role      @default(LOADER)
  active          Boolean   @default(true)
  tokenVersion    Int       @default(0)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  telegramChatId  String?   @unique
  transfers       Transfer[]
  receipts        Receipt[]
  orders          Order[]   @relation("KnitterOrders")
  assignedOrders  Order[]   @relation("AssignedOrders")
  deliveredOrders Order[]   @relation("DeliveredOrders")
}

enum Role {
  LOADER
  KNITTER
  ADMIN
}

model Location {
  id        String          @id @default(cuid())
  type      LocationType    @unique
  name      String
  movements StockMovement[]
  receipts  Receipt[]
}

enum LocationType {
  HOME
  WAREHOUSE
  WORKSHOP
}

model Yarn {
  id            String         @id @default(cuid())
  article       String         @unique
  type          String?
  color         String?
  composition   String?
  thickness     String?
  unit          String         @default("кг")
  status        YarnStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now())
  movements     StockMovement[]
  receiptItems  ReceiptItem[]
  transferItems TransferItem[]
  orderItems    OrderItem[]
}

enum YarnStatus {
  PENDING
  ACTIVE
  ARCHIVED
}

model Receipt {
  id         String        @id @default(cuid())
  admin      User          @relation(fields: [adminId], references: [id])
  adminId    String
  location   Location      @relation(fields: [locationId], references: [id])
  locationId String
  status     ReceiptStatus @default(SENT)
  note       String?
  createdAt  DateTime      @default(now())
  items      ReceiptItem[]
  movements  StockMovement[]
}

enum ReceiptStatus {
  SENT
  CANCELLED
}

model ReceiptItem {
  id        String  @id @default(cuid())
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  receiptId String
  yarn      Yarn    @relation(fields: [yarnId], references: [id])
  yarnId    String
  quantity  Decimal @db.Decimal(10, 2)
}

model Transfer {
  id        String         @id @default(cuid())
  loader    User           @relation(fields: [loaderId], references: [id])
  loaderId  String
  status    TransferStatus @default(SENT)
  note      String?
  createdAt DateTime       @default(now())
  items     TransferItem[]
  movements StockMovement[]
}

enum TransferStatus {
  SENT
  CANCELLED
}

model TransferItem {
  id               String           @id @default(cuid())
  transfer         Transfer         @relation(fields: [transferId], references: [id], onDelete: Cascade)
  transferId       String
  yarn             Yarn             @relation(fields: [yarnId], references: [id])
  yarnId           String
  quantity         Decimal          @db.Decimal(10, 2)
  fromType         TransferFromType
  receiptUrl       String?
  discordMessageId String?
}

enum TransferFromType {
  HOME
  WAREHOUSE
  CITY_BUY
}

model Order {
  id               String      @id @default(cuid())
  knitter          User        @relation("KnitterOrders", fields: [knitterId], references: [id])
  knitterId        String
  status           OrderStatus @default(PENDING)
  note             String?
  assignedLoader   User?       @relation("AssignedOrders", fields: [assignedLoaderId], references: [id])
  assignedLoaderId String?
  assignedAt       DateTime?
  deliveredBy      User?       @relation("DeliveredOrders", fields: [deliveredById], references: [id])
  deliveredById    String?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime    @default(now())
  items            OrderItem[]

  @@index([status, createdAt])
}

enum OrderStatus {
  PENDING
  DELIVERED
  CANCELLED
}

model OrderItem {
  id       String      @id @default(cuid())
  order    Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  String
  yarn     Yarn        @relation(fields: [yarnId], references: [id])
  yarnId   String
  quantity Decimal     @db.Decimal(10, 2)
  source   OrderSource
}

enum OrderSource {
  HOME
  WAREHOUSE
  CITY_BUY
}

model StockMovement {
  id         String    @id @default(cuid())
  yarn       Yarn      @relation(fields: [yarnId], references: [id])
  yarnId     String
  location   Location  @relation(fields: [locationId], references: [id])
  locationId String
  quantity   Decimal   @db.Decimal(10, 2)
  receipt    Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  receiptId  String?
  transfer   Transfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)
  transferId String?
  isInitial  Boolean   @default(false)
  reason     String?
  createdAt  DateTime  @default(now())
  @@index([yarnId, locationId])
}